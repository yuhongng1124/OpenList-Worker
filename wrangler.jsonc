// =============================================================================
// OpenList-TSWorker · Cloudflare Workers 配置（已改为 D1 + sql，并开启 workers.dev）
// 文档：https://developers.cloudflare.com/workers/wrangler/configuration/
//
// Secret（JWT_SECRET / ADMIN_PASS / ALLOW_URLS 等）不要写在本文件，
// 请在 Cloudflare 后台「设置 → 变量和机密」以【密钥 / Secret】类型添加，
// 后续部署不会被覆盖。
// =============================================================================
{
  "name": "openlist-tsworkers",
  "main": "src/backend/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],

  // ✅ 已改：开启 *.workers.dev 网址
  "workers_dev": true,
  "preview_urls": false,

  // run_worker_first 只放行 HTML 入口，不要改成 true
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  },

  // ===========================================================================
  // 普通环境变量（每次 wrangler deploy 时以本文件为准）
  // ===========================================================================
  "vars": {
    "ENVIRONMENT": "production",

    // ✅ 已改：关系表格式，与 Go 后端一致
    "DB_FORMAT": "sql",

    // ✅ 已改：使用 Cloudflare D1（需下方 d1_databases）
    "DB_DRIVER": "d1",

    // 敏感字段加密：none（不加密）/ aes-256-gcm（推荐，依赖 JWT_SECRET，之后不可更改该密钥）
    "DB_CIPHER": "none",

    // ── 缓存 ─────────────────────────────────────────────────────────────
    "CACHE_ENABLED": "true",
    "CACHE_DRIVER": "db",
    "CACHE_FILE_TREE": "true",
    "CACHE_DOWNLOAD_LINK": "false",
    "CACHE_TTL": "0",
    "CACHE_LINK_TTL": "5",
    "CACHE_EXCLUDE_DRIVERS": "virtual,alias,url_tree,strm,chunk",

    // ── singleflight（并发相同调用去重）────────────────────────────────
    "SINGLEFLIGHT": "auto"

    // ── 可选参数（需要时取消注释，注意给上一行补逗号）──────────────────
    // "MAX_UPLOAD": "26214400",
    // "MAX_UPPART": "16777216",
    // "ASSET_URLS": "https://cdn.jsdelivr.net/npm/@openlist-frontend/openlist-frontend@$version/dist",
    // "ALLOW_SEED": ""
  },

  // ===========================================================================
  // 存储绑定
  // ===========================================================================
  // ✅ 已启用 D1，绑定名必须是 DB（使用后台已建好的 openlist-db）
  "d1_databases": [
    { "binding": "DB", "database_name": "openlist-db", "database_id": "8ce5c981-aefb-4f76-99ce-9b3709908641" }
  ]

  // ▶ 可选：R2 对象存储（作为网盘存储驱动使用，与数据库无关）
  // ,"r2_buckets": [
  //   { "binding": "R2", "bucket_name": "your-bucket" }
  // ]
}
